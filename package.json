{
  "name": "nismos-cms",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter admin-telegram dev",
    "build": "pnpm --filter admin-telegram build",
    "start": "pnpm --filter admin-telegram start",
    "lint": "pnpm --filter admin-telegram lint",
    "typecheck": "pnpm --filter admin-telegram typecheck",
    "test": "pnpm --filter admin-telegram test",
    "test:e2e": "pnpm --filter admin-telegram test:e2e",
    "telegram:login": "pnpm --filter admin-telegram telegram:login",
    "telegram:verify": "pnpm --filter admin-telegram telegram:verify",
    "format": "prettier --write apps package.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps package.json pnpm-workspace.yaml"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
